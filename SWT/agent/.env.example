# Sao chép file này thành .env rồi điền API Key vào
# Windows: copy .env.example .env
# Mac/Linux: cp .env.example .env

# === CHỌN 1 TRONG 2 PROVIDER ===

# Option 1 — Anthropic Claude (trả phí, chất lượng cao)
# Lấy tại: https://console.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# Option 2 — Groq (MIỄN PHÍ, 14,400 request/ngày)
# Lấy tại: https://console.groq.com/keys
GROQ_API_KEY=gsk_...
