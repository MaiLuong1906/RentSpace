# ============================================================
# RentSpace — Environment Variables Template
# ============================================================
# Sao chép file này thành .env và điền các giá trị thực
# ⚠️ KHÔNG BAO GIỜ commit file .env lên Git
# ============================================================

# ===== Database =====
DB_USERNAME=postgres
DB_PASSWORD=your_strong_password_here

# ===== Redis =====
REDIS_PASSWORD=

# ===== JWT =====
# Tạo secret mạnh: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_base64_encoded_here

# ===== Email (Gmail SMTP) =====
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# ===== AWS S3 =====
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key
AWS_S3_BUCKET=rentspace-uploads
AWS_REGION=ap-southeast-1
# AWS_S3_ENDPOINT_URL=http://localhost:9000  # Để trống nếu dùng AWS S3 thật, điền nếu dùng MinIO local dev

# ===== Next Auth =====
# Tạo secret: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here

# ===== Google OAuth =====
# Tạo tại: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ===== Mapbox =====
# Tạo tại: https://www.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# ===== VNPay (Phase 2) =====
VNPAY_TMN_CODE=your_tmn_code
VNPAY_HASH_SECRET=your_hash_secret
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/app/payment/result
VNPAY_IPN_URL=http://localhost:8080/api/v1/deposits/webhook/vnpay

# ===== Groq API — Phase 4 Sprint 6: Contract AI Assistant =====
# Đăng ký miễn phí (không cần thẻ) tại: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ===== MoMo (Sprint 0) =====
MOMO_PARTNER_CODE=MOMOBKUN20180529
MOMO_ACCESS_KEY=klm05TvNBzhg7h7j
